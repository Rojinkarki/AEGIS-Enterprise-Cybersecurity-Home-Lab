# ==========================================
# AEGIS Enterprise Cyber Range - .gitignore
# ==========================================

# ISO installation media
*.iso

# VirtualBox virtual machines
*.vdi
*.vbox
*.vbox-prev
*.vmdk
*.ova
*.ovf
*.sav

# VirtualBox logs and snapshots
Logs/
Snapshots/

# Packet captures
*.pcap
*.pcapng

# Splunk / SIEM generated data
splunk-data/
*.log

# Temporary files
*.tmp
*.temp
~*

# Windows files
Thumbs.db
Desktop.ini

# Secrets / credentials
*.key
*.pem
*.pfx
*.p12
.env
secrets/
credentials/

# Python
__pycache__/
*.pyc
.venv/
venv/

*.iso.bz2

# Additional credentials and raw evidence exports
.env.*
!.env.example
id_rsa
id_ed25519
id_ecdsa
client.keys
*.ppk
*.kdbx
*.jks
*.keystore
*.har
*.evtx
config.xml
config-*.xml
*.conf.bak
auth/
private/

# Local validation scratch files
.validation-tmp/
